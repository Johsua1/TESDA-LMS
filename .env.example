# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in your Supabase project values.
# `.env.local` is git-ignored — it will NOT be committed or deployed.
# ---------------------------------------------------------------------------

# Project Settings > API > Project URL
VITE_SUPABASE_URL=

# Project Settings > API > Project API keys > anon public
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# SETUP ONLY — server-side secrets. NEVER expose these to the browser.
# Only needed if you later use the Supabase CLI (supabase link / db push) or
# server-side scripts. The SQL-Editor setup does NOT require them.
# ---------------------------------------------------------------------------
# Personal access token: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
# Project Settings > API > Project API keys > service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# SETUP SCRIPTS (scripts/create-super-admin.mjs, scripts/mfa-enroll.mjs)
# ---------------------------------------------------------------------------
# Designated Super Admin account (created by scripts/create-super-admin.mjs).
SUPER_ADMIN_EMAIL=institutehytglobal@gmail.com

# ---------------------------------------------------------------------------
# SUPABASE AUTH CONFIG — pushed to the project by scripts/configure-auth.mjs
# These are NOT read by Vite (no VITE_ prefix) and never reach the browser.
# Run: node scripts/configure-auth.mjs
# ---------------------------------------------------------------------------
# Site URL + allowed redirect URLs (for activation / password-reset links).
# The Site URL is also the issuer shown in authenticator apps (Google
# Authenticator etc.), so point it at the deployed portal — not localhost.
AUTH_SITE_URL=https://tesda-lms-qt64.vercel.app
AUTH_REDIRECT_URLS=https://tesda-lms-qt64.vercel.app,https://tesda-lms-qt64.vercel.app/**,http://localhost:5173,http://localhost:5173/**
# Subject of the branded trainer email. The HTML body is read from
# supabase/templates/recovery.html and pushed to the "Reset Password" template.
AUTH_RECOVERY_SUBJECT=Your HYT Global Institute LMS Portal access
# Gmail SMTP. Leave SMTP_PASS blank to keep the password already stored in
# Supabase; fill it in (Gmail App Password) only to (re)apply it.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=institutehytglobal@gmail.com
SMTP_PASS=
SMTP_SENDER_EMAIL=institutehytglobal@gmail.com
SMTP_SENDER_NAME=HYT Global Institute
# Seconds between auth emails (Supabase throttle). 1 = allow quick bulk onboarding.
SMTP_MAX_FREQUENCY=1

# ---------------------------------------------------------------------------
# EDGE FUNCTION SECRETS (set with `supabase secrets set ...`)
# Never place these in the Vite/browser environment.
# ---------------------------------------------------------------------------
# Public URL of the deployed frontend (used in invitation links).
APP_URL=http://localhost:5173
# Where the activation/recovery link sends the trainer.
APP_ACTIVATION_REDIRECT_URL=http://localhost:5173/login
INSTITUTION_NAME=HYT Global Institute

# Email provider (optional). If omitted, Supabase's built-in invite email is
# used and no temporary password is generated.
RESEND_API_KEY=
EMAIL_FROM=HYT Global Institute <no-reply@example.com>
