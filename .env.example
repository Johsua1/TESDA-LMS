# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in your Supabase project values.
# `.env.local` is git-ignored — it will NOT be committed or deployed.
# ---------------------------------------------------------------------------

# Project Settings > API > Project URL
VITE_SUPABASE_URL=

# Project Settings > API > Project API keys > anon public
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# SETUP ONLY — server-side secrets. NEVER expose these to the browser.
# Only needed if you later use the Supabase CLI (supabase link / db push) or
# server-side scripts. The SQL-Editor setup does NOT require them.
# ---------------------------------------------------------------------------
# Personal access token: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
# Project Settings > API > Project API keys > service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=
